# Server
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/saathi?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Client CORS (can be comma-separated origins)
# Example: https://main.d12345.amplifyapp.com,https://yourdomain.com
CLIENT_URL=https://main.d12345.amplifyapp.com

# Rate Limiting — Per User
USER_MINUTE_AI_LIMIT=10
USER_DAILY_AI_LIMIT=100

# Rate Limiting — Global Application Budget
GLOBAL_DAILY_REQUEST_LIMIT=5000
GLOBAL_DAILY_TOKEN_LIMIT=2000000
